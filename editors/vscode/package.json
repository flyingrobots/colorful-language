{
  "name": "colorful-language",
  "displayName": "Colorful Language",
  "description": "Part-of-speech syntax highlighting for English prose, via the colorful-lsp language server.",
  "version": "0.4.0",
  "publisher": "flyingrobots",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingrobots/colorful-language",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "prose",
    "english",
    "syntax highlighting",
    "part of speech"
  ],
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[plaintext]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[markdown]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Colorful Language",
      "properties": {
        "colorful.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Colorful prose highlighting."
        },
        "colorful.serverPath": {
          "type": "string",
          "default": "colorful-lsp",
          "description": "Path to the colorful-lsp binary. For this source extension, install the server from the same Colorful checkout; see the extension README."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "noun",
        "superType": "variable",
        "description": "English noun"
      },
      {
        "id": "verb",
        "superType": "function",
        "description": "English verb"
      },
      {
        "id": "adjective",
        "superType": "property",
        "description": "English adjective"
      },
      {
        "id": "adverb",
        "superType": "keyword",
        "description": "English adverb"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "plaintext",
        "scopes": {
          "noun": [
            "variable.other.colorful.noun"
          ],
          "verb": [
            "entity.name.function.colorful.verb"
          ],
          "adjective": [
            "variable.other.property.colorful.adjective"
          ],
          "adverb": [
            "keyword.other.colorful.adverb"
          ]
        }
      },
      {
        "language": "markdown",
        "scopes": {
          "noun": [
            "variable.other.colorful.noun"
          ],
          "verb": [
            "entity.name.function.colorful.verb"
          ],
          "adjective": [
            "variable.other.property.colorful.adjective"
          ],
          "adverb": [
            "keyword.other.colorful.adverb"
          ]
        }
      }
    ]
  },
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
    "compile": "tsc -p ./ --noEmit && npm run bundle",
    "package:vsix": "node scripts/package-vsix.mjs",
    "smoke:package": "node smoke/run-packaged-smoke.mjs",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "ovsx": "1.0.2",
    "typescript": "5.9.3"
  }
}
